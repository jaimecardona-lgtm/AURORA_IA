# Copiar a backend/.env (NO versionar). VALORES FICTICIOS: sustituir con los del panel de Supabase.
# Nunca pegar aquí una clave secreta/service_role.

APP_ENV=development

# Proyecto Supabase: Project Settings → API (URL y clave PUBLISHABLE).
SUPABASE_URL=https://proyecto-ficticio.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_clave_ficticia_no_real

# Validación del JWT de Supabase Auth (valores por defecto correctos para Supabase).
# Si se dejan vacíos se derivan así:
#   JWT_ISSUER        = {SUPABASE_URL}/auth/v1
#   JWT_JWKS_URL      = {JWT_ISSUER}/.well-known/jwks.json
JWT_ISSUER=
JWT_AUDIENCE=authenticated
JWT_JWKS_URL=
JWT_LEEWAY_SECONDS=10

# Tiempo máximo de espera hacia Supabase (segundos).
SUPABASE_TIMEOUT_SECONDS=8

# Orígenes CORS separados por coma. Vacío = sin CORS (el frontend va en el mismo origen).
CORS_ORIGINS=http://localhost:5173

# Carpeta del frontend compilado (vacío o inexistente = solo API).
# STATIC_DIR=../frontend/dist

# Claves de IA (OpenRouter): NO se usan en la Fase 01. Se añadirán en fases posteriores,
# siempre solo en el backend.

# ----------------------------------------------------------------------
# Copiloto (OpenRouter). La clave SOLO va en el entorno del servidor, nunca en el repositorio.
# Ejemplos no secretos: deje OPENROUTER_API_KEY vacía en el archivo versionado y defínala en
# backend/.env local o en el panel de variables del servidor.
# ----------------------------------------------------------------------
OPENROUTER_API_KEY=
# Identificador de modelo tal como aparece en https://openrouter.ai/models (verificar antes de usar).
OPENROUTER_MODEL=
# Opcional: modelos alternativos, separados por coma, solo IDs terminados en :free.
# OpenRouter aplica el fallback en una sola peticion. Confirma disponibilidad antes de usarlos.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_TIMEOUT_SECONDS=20
# openrouter | simulado (simulado solo en desarrollo; no es IA)
COPILOT_PROVIDER=openrouter
COPILOT_MAX_TOKENS=700
COPILOT_REQUESTS_PER_MINUTE=10
COPILOT_DAILY_TOKENS=100000
COPILOT_CONCURRENCY=2
